# =============================================================================
# PP6 - Práctica Profesional VI
# backend-remoto.tf.ejemplo — Configuración de backend remoto S3 + DynamoDB
# =============================================================================
# INSTRUCCIONES:
#   1. Completar los valores de bucket, region y account_id
#   2. Ejecutar los comandos de "Paso previo" (abajo)
#   3. Copiar el bloque "backend" dentro del bloque "terraform {}" de main.tf
#   4. Ejecutar: terraform init -migrate-state
#
# ─── PASO PREVIO: Crear recursos de backend en AWS ───────────────────────────
#
#   # Crear bucket S3 (reemplazar ACCOUNT_ID)
#   aws s3api create-bucket \
#     --bucket pp6-terraform-state-ACCOUNT_ID \
#     --region us-east-1
#
#   # Habilitar versionado en el bucket (MUY importante para recuperar estados)
#   aws s3api put-bucket-versioning \
#     --bucket pp6-terraform-state-ACCOUNT_ID \
#     --versioning-configuration Status=Enabled
#
#   # Habilitar cifrado en reposo
#   aws s3api put-bucket-encryption \
#     --bucket pp6-terraform-state-ACCOUNT_ID \
#     --server-side-encryption-configuration \
#       '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}'
#
#   # Crear tabla DynamoDB para locking
#   aws dynamodb create-table \
#     --table-name pp6-terraform-locks \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST \
#     --region us-east-1
#
# ─── BLOQUE A AGREGAR EN main.tf dentro de terraform {} ──────────────────────
#
# backend "s3" {
#   bucket         = "pp6-terraform-state-ACCOUNT_ID"
#   key            = "laboratorio/terraform.tfstate"
#   region         = "us-east-1"
#   dynamodb_table = "pp6-terraform-locks"
#   encrypt        = true
# }
#
# ─── VERIFICAR MIGRACIÓN ─────────────────────────────────────────────────────
#
#   terraform init -migrate-state
#   # Responder "yes" para mover el estado local a S3
#
#   terraform state list
#   # Verificar que todos los recursos siguen en el estado
